// Spanish classical guitar (FreePats, CC0) - cut for ScaleForge
// Regions as in the original .sfz; loops dropped, samples cut to 10s with a fade
// volume= per region evens the loudness (first 1.5 s, EBU R128) to the set median -16.8 LUFS
<global>
 ampeg_release=1.5
 // tone and variation, read by hd.js [H45]: softer = darker, a little random level / pitch / tone / start
 cutoff=1000 fil_veltrack=5000 fil_random=150
 amp_random=1.5 pitch_random=5 offset_random=220

<region>
 lokey=29 hikey=31 pitch_keycenter=31
 sample=31.ogg
 volume=-4.2

<region>
 lokey=32 hikey=32 pitch_keycenter=32
 sample=32.ogg
 volume=-3.6

