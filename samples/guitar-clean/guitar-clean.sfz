// EGuitar Cl. Br. Sm. (FreePats, CC0) - cut for ScaleForge
// Regions as in the original .sfz; loops dropped, samples cut to 10s with a fade
// volume= per region evens the loudness (first 1.5 s, EBU R128) to the set median -13.2 LUFS
<global>
 ampeg_release=1.1
 // tone and variation, read by hd.js [H45]: softer = darker, a little random level / pitch / tone / start
 cutoff=900 fil_veltrack=5600 fil_random=150
 amp_random=1.5 pitch_random=5 offset_random=220

<region>
 lokey=35 hikey=38 pitch_keycenter=36
 sample=36.ogg
 volume=-5.4

<region>
 lokey=39 hikey=42 pitch_keycenter=41
 sample=41.ogg
 volume=-4.2

<region>
 lokey=43 hikey=46 pitch_keycenter=45
 sample=45.ogg
 volume=-2

<region>
 lokey=47 hikey=49 pitch_keycenter=48
 sample=48.ogg
 volume=-4.8

<region>
 lokey=50 hikey=53 pitch_keycenter=52
 sample=52.ogg

<region>
 lokey=54 hikey=56 pitch_keycenter=55
 sample=55.ogg

<region>
 lokey=57 hikey=61 pitch_keycenter=59
 sample=59.ogg
 volume=1.9

<region>
 lokey=62 hikey=65 pitch_keycenter=64
 sample=64.ogg
 volume=0.6

<region>
 lokey=66 hikey=69 pitch_keycenter=67
 sample=67.ogg
 volume=1.1

<region>
 lokey=70 hikey=72 pitch_keycenter=71
 sample=71.ogg
 volume=3.1

<region>
 lokey=73 hikey=76 pitch_keycenter=74
 sample=74.ogg
 volume=0.7

<region>
 lokey=77 hikey=82 pitch_keycenter=80
 sample=80.ogg

<region>
 lokey=83 hikey=86 pitch_keycenter=85
 sample=85.ogg
